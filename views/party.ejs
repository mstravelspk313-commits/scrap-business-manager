<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Party Ledger - Scrap Business Manager</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <% include partials/header.ejs %>
  <main>
    <div class="container grid grid-2">
      <div class="card">
        <h2><%= party.name %></h2>
        <p>Complete history of purchases, sales, and payments for this party.</p>
        <div style="margin-top: 12px;">
          <a href="/dashboard">← Back to Dashboard</a>
        </div>
      </div>
      <div class="card">
        <h3>Current Capital</h3>
        <h2><%= capital.toLocaleString("en-PK", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></h2>
        <h4 style="margin-top: 12px;">Stock Snapshot</h4>
        <% Object.keys(stock).forEach((item) => { %>
          <div style="display:flex; justify-content:space-between; padding:6px 0;">
            <span><%= item %></span>
            <strong><%= stock[item].toFixed(2) %></strong>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="container card">
      <h3>Party Transactions</h3>
      <table class="table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Item</th>
            <th>Weight</th>
            <th>Amount</th>
            <th>Notes</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% transactions.forEach((entry) => { %>
            <tr>
              <td><%= entry.created_at %></td>
              <td><span class="badge"><%= entry.type %></span></td>
              <td><%= entry.item_type || "-" %></td>
              <td><%= entry.weight ? Number(entry.weight).toFixed(2) : "-" %></td>
              <td><%= Number(entry.amount).toFixed(2) %></td>
              <td><%= entry.notes || "-" %></td>
              <td>
                <% if (entry.deleted_at) { %>
                  <span class="badge" style="background:#fee2e2; color:#991b1b;">Deleted</span>
                <% } else { %>
                  <span class="badge" style="background:#dcfce7; color:#166534;">Active</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
          <% if (transactions.length === 0) { %>
            <tr>
              <td colspan="7">No transactions yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
